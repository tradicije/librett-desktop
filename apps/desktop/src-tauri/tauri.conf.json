{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreTT",
  "version": "0.1.0-beta.1",
  "identifier": "org.librett.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "LibreTT",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "publisher": "Aleksa Dimitrijević",
    "category": "Sports",
    "shortDescription": "Offline table-tennis tournament management",
    "longDescription": "Free and open-source desktop application for organizing table-tennis tournaments, with local data, draws, scoring, standings, cash desk and backups.",
    "homepage": "https://github.com/tradicije/librett-desktop",
    "copyright": "Copyright (C) 2026 Aleksa Dimitrijević",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../docs/licenses/tabler-icons-MIT.txt": "licenses/tabler-icons-MIT.txt",
      "../../../docs/licenses/libre-franklin-OFL.txt": "licenses/libre-franklin-OFL.txt"
    }
  }
}
