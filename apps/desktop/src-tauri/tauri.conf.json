{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibreTT",
  "version": "0.1.0",
  "identifier": "org.librett.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "LibreTT", "width": 1200, "height": 800, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": { "active": false }
}
