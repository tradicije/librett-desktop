{
  "name": "librett",
  "version": "0.1.0-beta.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Aleksa Dimitrijević",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @librett/desktop",
    "check": "npm run check --workspace @librett/desktop",
    "build": "npm run build --workspace @librett/desktop",
    "desktop:install-icon": "node scripts/install-linux-dev-icon.mjs",
    "desktop:generate-icons": "node scripts/generate-desktop-icons.mjs",
    "desktop": "npm run tauri --workspace @librett/desktop --",
    "test:reports": "node scripts/verify-reports.mjs",
    "test:core": "cargo test --workspace --exclude librett-desktop",
    "desktop:build": "npm run desktop -- build",
    "desktop:collect": "node scripts/collect-installers.mjs"
  }
}
